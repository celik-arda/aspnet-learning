@using form_task_arda.DTOs;
@using form_task_arda.Models;
@using form_task_arda.Data;
@model List<GiderlerDTO>;



<div class="container">
    <ul class="giders_list_area list-group">

        <li class="giders_header giders_list_element list-group-item d-flex justify-between container">
            <div class="col-4 text-primary border-primary">Gider Adı</div>
            <div class="col-3 text-primary border-primary">Gider Türü</div>
            <div class="col-2 text-primary  border-primary">Maliyet</div>
            <div class="col-3  text-primary border-primary">Ödenen Tarih</div>
        </li>

        @foreach (var item in Model)
        {
            <li class="giders_list_element list-group-item d-flex justify-between container">
                <div class="col-4 border-primary">@item.Gider_Adi</div>
                <div class="col-3 border-primary">@item.Gider_Kategorisi</div>
                <div class="col-2 border-primary">@item.Gider_Ucreti TL</div>
                <div class="col-2 border-primary">
                    @{
                        int kacGunOnce = (DateTime.Today.Date - @item.Gider_Tarihi.Date).Days;
                    }
                    @kacGunOnce gün önce
                </div>
                <div class="gider_button_area col-1 border-primary ps-0 d-flex justify-around align-center">

                    <a class="btn">
                        <svg class="gider_edit_icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                        </svg>
                    </a>

                    <a asp-controller="Giders" asp-action="RemoveThisGider" asp-route-_id="@item.Gider_Id" class="btn">
                        <svg class="gider_remove_icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-x-square-fill" viewBox="0 0 16 16">
                            <path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm3.354 4.646L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 1 1 .708-.708" />
                        </svg>
                    </a>
                </div>
            </li>

        }
    </ul>
</div>