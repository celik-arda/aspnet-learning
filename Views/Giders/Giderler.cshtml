@using form_task_arda.DTOs;
@using form_task_arda.Models;
@using form_task_arda.Data;
@model List<GiderlerDTO>;



<div class="container">
    <ul class="giders_list_area list-group">

        <li class="giders_header giders_list_element list-group-item d-flex justify-between container">
            <div class="col-4 text-primary border-primary">Gider Adı</div>
            <div class="col-3 text-primary border-primary">Gider Türü</div>
            <div class="col-2 text-primary  border-primary">Maliyet</div>
            <div class="col-3  text-primary border-primary">Ödenen Tarih</div>
        </li>

        @foreach (var item in Model)
        {
            <li class="giders_list_element list-group-item d-flex justify-between container">
                <div class="col-4 border-primary">@item.Gider_Adi</div>
                <div class="col-3 border-primary">@item.Gider_Kategorisi</div>
                <div class="col-2 border-primary">@item.Gider_Ucreti TL</div>
                <div class="col-3 border-primary">
                    @{
                        int kacGunOnce = (DateTime.Today.Date - @item.Gider_Tarihi.Date).Days;
                    }
                    @kacGunOnce gün önce
                </div>
            </li>

        }
    </ul>
</div>