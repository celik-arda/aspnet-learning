<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - form_task_arda</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/form_task_arda.styles.css" asp-append-version="true" />


    @* Font Family that is used in original site *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">


</head>
<body>
    <header>

        <nav class="navbar box-shadow">
            <div class="container-fluid d-flex justify-content-start align-items-center">

                <a class="navbar-brand website-icon" asp-for="Index">
                    <img id="website_big_icon" src="~/images/front_big_logo.svg" alt="Firma Logosu" height="34" class="d-inline-block justify-content-between">
                </a>

                @* openning-canvas button *@
                <button class="navbar-toggler navbar-openning-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar" aria-controls="offcanvasDarkNavbar" aria-label="Toggle navigation">
                <a>
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-arrow-bar-right" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M6 8a.5.5 0 0 0 .5.5h5.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L12.293 7.5H6.5A.5.5 0 0 0 6 8m-2.5 7a.5.5 0 0 1-.5-.5v-13a.5.5 0 0 1 1 0v13a.5.5 0 0 1-.5.5"/>
                    </svg>  
                </a>
                </button>

                @* <div class="navbar col-6 ms-5">
                    <form class="d-flex" role="search">
                        <div class="position-relative">
                            <input class="form-control ps-5 me-2 nav-search-input" type="search" placeholder="Search in front" aria-label="Search"/>
                            <span class="nav-search-icon">
                                <a class="btn text-left search-button-link">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                                    </svg>
                                </a>
                            </span>
                        </div>
                    </form>
                </div> *@

                <div class="col-4 offcanvas show offcanvas-start navbar-canvas-menu"  id="offcanvasDarkNavbar" aria-labelledby="offcanvasDarkNavbarLabel">
                    <div class="offcanvas-header">
                        <span><img class="nav-canvas-icon" src="~/images/front_small_logo.svg" alt=""></span>

                        @* closing-canvas button *@
                        <button type="button navbar-closing-button" class="btn-close my-close-icon" data-bs-dismiss="offcanvas" aria-label="Close">

                    </div>

                    @* (Start) Navbar List *@
                    <div class="offcanvas-body">
                        <h3 class="nav-heading px-2 text-white h6 fw-bold">SEÇENEKLER</h3>

                        <ul class="navbar-nav gap-2">
                            <li class="nav-item px-4">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item px-4">
                                <a class="nav-link" asp-controller="Giders" asp-action="Giderler">Giderler</a>
                            </li>
                            <li class="nav-item px-4">
                                <a class="nav-link" asp-controller="Giders" asp-action="AddNewGider">Gider Ekle</a>
                            </li>
                            <li class="nav-item px-4">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Tedarikçiler</a>
                            </li>
                            <li class="nav-item px-4">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Hesabım</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ps-4" href="#authMenu" data-bs-toggle="collapse" role="button">Authentication
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-caret-down" viewBox="0 0 16 16">
                                    <path d="M3.204 5h9.592L8 10.481zm-.753.659 4.796 5.48a1 1 0 0 0 1.506 0l4.796-5.48c.566-.647.106-1.659-.753-1.659H3.204a1 1 0 0 0-.753 1.659"/>
                                    </svg>
                                </a>

                                @* (Start) Authentication Sub-Options Collapse *@
                                <div class="collapse" id="authMenu">
                                    <ul class="navbar-nav ps-0">
                                        <li class="nav-item px-4">
                                            <a class="nav-link" asp-controller="Auth" asp-action="Register_Form">Register</a>
                                        </li>
                                        <li class="nav-item px-4 d-flex justify-content-between align-items-center">
                                            <a class="nav-link" asp-controller="Auth" asp-action="Login_Form">Login</a>
                                        </li>
                                        <li class="nav-item px-4">
                                            <a class="nav-link" asp-controller="Auth" asp-action="Logout">Logout</a>
                                        </li>
                                    </ul>
                                </div>
                                @* (End) Authentication Options Collapse *@

                            </li>
                        </ul>
                    </div>
                    @* (End) Navbar List *@
                </div>

            </div>
        </nav>

    </header>


    <div class="container">
        <main role="main" class="pb-3">
            <div class="container d-flex flex-column justify-content-center">
                @RenderBody()
            </div>
        </main>
    </div>




    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/script.js"></script>
    
</body>
</html>
