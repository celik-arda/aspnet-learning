<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - form_task_arda</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/form_task_arda.styles.css" asp-append-version="true" />


    @* Font Family that is used in original site *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">


</head>
<body>
    <header>

        <nav class="navbar box-shadow">
            <div class="container-fluid">

                <a class="navbar-brand website-icon" asp-for="Index">
                    <img src="~/images/proventa_icon.png" alt="Firma Logosu" height="34" class="d-inline-block align-text-top">
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar" aria-controls="offcanvasDarkNavbar" aria-label="Toggle navigation">
                    @* <span class="navbar-toggler-icon">
                    </span> *@
                    @* <i class="navbar-toggler-icon fa-regular fa-circle-left"></i> *@
                    <svg class="navbar-toggler-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M112 320C112 205.1 205.1 112 320 112C434.9 112 528 205.1 528 320C528 434.9 434.9 528 320 528C205.1 528 112 434.9 112 320zM576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576C461.4 576 576 461.4 576 320zM188.7 308.7C182.5 314.9 182.5 325.1 188.7 331.3L292.7 435.3C297.3 439.9 304.2 441.2 310.1 438.8C316 436.4 320 430.5 320 424L320 352L424 352C437.3 352 448 341.3 448 328L448 312C448 298.7 437.3 288 424 288L320 288L320 216C320 209.5 316.1 203.7 310.1 201.2C304.1 198.7 297.2 200.1 292.7 204.7L188.7 308.7z"/></svg>
                </button>

                <div class="offcanvas offcanvas-start border border-warning"  id="offcanvasDarkNavbar" aria-labelledby="offcanvasDarkNavbarLabel">
                    <div class="offcanvas-header">
                        <h3>Menü</h3>
                        <button class="btn btn-close" data-bs-dismiss="offcanvas">
                        </button>
                    </div>
                    <div class="offcanvas-body">
                        <ul class="navbar-nav gap-2">
                            <li class="nav-item">
                                <a class="nav-link border border-2 rounded-2" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link border border-2 rounded-2" asp-controller="Auth" asp-action="Register_Form">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link border border-2 rounded-2" asp-controller="Auth" asp-action="Login_Form">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link border border-2 rounded-2" asp-controller="Auth" asp-action="Logout">Logout</a>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </nav>

    </header>


    <div class="container">
        <main role="main" class="pb-3">
            <div class="container d-flex justify-content-center">
                @RenderBody()
            </div>
        </main>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
