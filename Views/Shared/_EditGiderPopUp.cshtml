@* <div class="container col-xl-4 col-lg-4 col-10 mx-auto text-center mt-5 p-5 register_form_container"> *@


<div class="modal-header">
    <h2 class="text-primary mb-3">Edit Gider</h2>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">


    <form class="d-flex flex-column gap-2" method="post" asp-controller="Giders" asp-action="UpdateGider">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Gider_Id" />
        <div class="form-group">
            <label asp-for="@Model.Gider_Adi" >Gider Adı</label>
            <input asp-for="@Model.Gider_Adi" type="text" class="form-control" id="edit_gider_name" placeholder="Gider adını yazın">
        </div>

        <div class="form-group">
            <label asp-for="@Model.Gider_Kategorisi">Gider Kalemi</label>
            <input asp-for="@Model.Gider_Kategorisi" type="text" class="form-control" id="gider_edit_category" placeholder="Giderin türünü yazın">
        </div>

        <div class="form-group">
            <label asp-for="@Model.Gider_Ucreti" >Gider Bedeli</label>
            <input asp-for="@Model.Gider_Ucreti" type="number" class="form-control" id="gider_edit_price" aria- placeholder="Ne kadar tuttuğunu yazın">
        </div>

        <div class="modal-footer">
            <button type="submit" class="btn btn-primary w-50 m-auto mt-3">Değişikliği Kaydet</button>
        </div>



    </form>
</div>
@* </div> *@