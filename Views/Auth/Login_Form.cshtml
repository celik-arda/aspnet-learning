@model form_task_arda.DTOs.LoginFormDto;


<div class="container col-xl-4 col-lg-4 col-10 mx-auto text-center mt-5 p-5 login_form_container">

    <h2 class="text-primary mb-3">Login</h2>

    <form class="d-flex flex-column gap-2" method="post" asp-controller="Auth" asp-action="Login_Form">

        <div class="form-group">
            <label asp-for="Email">Email Address</label>
            <input asp-for="Email" type="email" class="form-control" id="exampleInputEmail2" aria-describedby="emailHelp" placeholder="Enter email">

        </div>

        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" class="form-control" id="exampleInputPassword3" placeholder="Password">
        </div>


        <button type="submit" class="btn btn-primary w-50 m-auto mt-3">Create Account</button>

    </form>
</div>