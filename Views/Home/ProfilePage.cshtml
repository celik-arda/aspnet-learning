@model form_task_arda.DTOs.CurrentUserDto;


<div class="profile_page_container container col-xl-4 col-lg-4 col-10 mx-auto text-center mt-5 p-5">

    <h2 class="text-primary mb-3">Hesabım</h2>

    <form class="d-flex flex-column gap-2">

        <div class="form-group">
            <label >FullName</label>
            <input readonly type="text" value="@Model.FullName" class="form-control" id="exampleInputPassword1" placeholder="FullName">
        </div>

        <div class="form-group">
            <label>UserName</label>
            <input readonly type="text" value="@Model.UserName" class="form-control" id="exampleInputPassword4" placeholder="Username">
        </div>

        <div class="form-group">
            <label >Email Address</label>
            <input readonly type="email" value="@Model.Email" class="form-control" id="exampleInputEmail2" aria-describedby="emailHelp" placeholder="Enter email">
        </div>

        <div class="bg-success w-50 m-auto mt-3">Online</div>

    </form>
</div>