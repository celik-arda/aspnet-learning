@using form_task_arda.Models;
@using form_task_arda.Controllers;
@model (int usersCount, int totalGidersPrice, int companiesCount);
@{
    ViewData["Title"] = "Home Page";
}


<section class="hero_image_section">

    <div class="hero_section_container mt-3">
        <h1 class="hero_section_title">Cafe Gider Takibi</h1>
    </div>

</section>

@* NOT : İçteki kutuları col-4 olarak tam 12'ye tamamlanacak şekilde verirsen araya gap değeri versen bile taşma yapar. Bunun yerine sadece col değeri verirsen içeriye göre eşit paylaştırır.' *@

<section class="all_page_links_section container mx-auto my-4 p-0">
    
    <div class="all_page_links_container container gap-3 d-flex justify-content-between align-items-center mx-auto px-0">
        <div class="home_boxes total_user_box col-lg d-flex flex-column justify-content-around p-3">
            <h1>@Model.usersCount</h1>
            <h3>Toplam kullanıcı</h3>
        </div>
        <div class="home_boxes total_gider_box col-lg d-flex flex-column justify-content-around p-3">
            <h1>@Model.totalGidersPrice TL</h1>
            <h3>Toplam Gider</h3>
        </div>
        <div class="home_boxes total_company_box col-lg d-flex flex-column justify-content-around p-3">
            <h1>@Model.companiesCount</h1>
            <h3>Tedarikçi Sayısı</h3>
        </div>
    </div>


</section>

<section class="home_graph_section container">
    <canvas id="myChart"></canvas>
</section>
